{
    "useTabs": false,
    "tabWidth": 4,
    "singleQuote": false,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 120,
    "plugins": ["prettier-plugin-svelte"],
    "overrides": [
        { "files": "*.svelte", "options": { "parser": "svelte" } },
        { "files": "*.md", "options": { "proseWrap": "preserve" } },
        { "files": "*.yml", "options": { "tabWidth": 2 } },
        { "files": "*.yaml", "options": { "tabWidth": 2 } }
    ]
}
