# Fixtures — captured real YouTube DOM, deliberately NOT published (privacy).
# Fixture-based tests skip themselves when these are absent (fixture-harness.ts).
**/__fixtures__/**
!**/__fixtures__

# Internal planning documents
docs/plans/

# Development stuff
# warn: root-anchored — a bare `dev/` would also swallow src/lib/dev/ (fixture capture
# tool, imported by src/main.ts and required for typecheck + `npm run build:dev`).
/dev/
docs/prototypes/

# Agent assistant state (personal skills, session recovery) — not part of the project
.kilo/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Build artifacts — note: emitted *.config.js next to a *.config.ts would SHADOW the
# real config (Vite loads .js first). tsconfig.json sets noEmit to prevent emission;
# these files are deliberately NOT gitignored so an accidental re-emission is visible.
tsconfig.node.tsbuildinfo
*.tsbuildinfo
.tsbuild-node/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright
playwright-report/
test-results/
.playwright/
